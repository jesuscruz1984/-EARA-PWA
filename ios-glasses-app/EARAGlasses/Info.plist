<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>EARA Glasses</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>UILaunchScreen</key>
  <dict/>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>EARA Glasses uses Bluetooth to connect to the W610 smart glasses.</string>
  <key>NSBluetoothPeripheralUsageDescription</key>
  <string>EARA Glasses uses Bluetooth to control the W610 smart glasses.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>EARA uses the microphone for voice conversations.</string>
  <key>NSCameraUsageDescription</key>
  <string>EARA uses camera access for visual questions.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>EARA Glasses connects to the glasses Wi-Fi network to transfer captured media.</string>
  <key>NSPhotoLibraryAddUsageDescription</key>
  <string>EARA Glasses may save captured glasses media for testing.</string>
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
    <string>bluetooth-central</string>
  </array>
</dict>
</plist>
